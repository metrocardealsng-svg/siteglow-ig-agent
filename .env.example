# Copy this file to .env for local testing (never commit .env to GitHub!)
# On GitHub, add these same keys under: Repo -> Settings -> Secrets and variables -> Actions

# 1. Gemini API key (free tier available at https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# 2. Official Meta Instagram Graph API (Business/Creator account linked to a Facebook Page)
IG_USER_ID=
IG_ACCESS_TOKEN=

# 3. Optional: Public file hosting for Instagram Graph API ingestion
# By default on GitHub Actions, the workflow automatically hosts the rendered media via
# GitHub Releases / raw repo branch OR Cloudinary if you set CLOUDINARY_* below.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=

# 4. Agent Mode: "auto" (alternates Reels & Carousels), "reel", or "carousel"
CONTENT_MODE=auto
# Set DRY_RUN=true to generate & inspect video/slides locally without publishing to Instagram
DRY_RUN=true
# Edge-TTS voice for Reels (en-NG-AbeoNeural = Nigerian Male, en-NG-EzinneNeural = Nigerian Female)
TTS_VOICE=en-NG-AbeoNeural
